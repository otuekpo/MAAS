DATABASE_URL=postgres://postgres:postgres@localhost:5432/maas_test
MONGODB_URI=mongodb://localhost:27017/maas_test?directConnection=true
SECRET_KEY=your_secret_key
MAAS_MAIN_SERVICE_PORT=4081
INJESTION_PORT=3001

# Redis (BullMQ broker)
REDIS_HOST=localhost
REDIS_PORT=6379

# Bull worker concurrency for sensor event processing
SENSOR_PROCESSOR_CONCURRENCY=5

# Super admin seeding (set SEED_SUPER_ADMIN=true to create on startup)
SEED_SUPER_ADMIN=false
SUPER_ADMIN_EMAIL=super@mailinator.com
SUPER_ADMIN_PASSWORD=change_me
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=admin

# SMTP (email confirmation / password reset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_EMAIL=info@maas.com
