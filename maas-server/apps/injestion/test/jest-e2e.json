{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/shared(|/.*)$": "<rootDir>/../../../libs/shared/src/$1",
    "^@app/database/pg-entities(|/.*)$": "<rootDir>/../../../libs/database/pg-entities/src/$1",
    "^@app/database/mongodb(|/.*)$": "<rootDir>/../../../libs/database/mongodb/src/$1",
    "^@app/email(|/.*)$": "<rootDir>/../../../libs/email/src/$1"
  }
}
