{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/maas-server/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/maas-server/tsconfig.app.json"
  },
  "projects": {
    "database/mongodb": {
      "type": "library",
      "root": "libs/database/mongodb",
      "entryFile": "index",
      "sourceRoot": "libs/database/mongodb/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/mongodb/tsconfig.lib.json"
      }
    },
    "database/pg-entities": {
      "type": "library",
      "root": "libs/database/pg-entities",
      "entryFile": "index",
      "sourceRoot": "libs/database/pg-entities/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/pg-entities/tsconfig.lib.json"
      }
    },
    "email": {
      "type": "library",
      "root": "libs/email",
      "entryFile": "index",
      "sourceRoot": "libs/email/src",
      "compilerOptions": {
        "tsConfigPath": "libs/email/tsconfig.lib.json"
      }
    },
    "injestion": {
      "type": "application",
      "root": "apps/injestion",
      "entryFile": "main",
      "sourceRoot": "apps/injestion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/injestion/tsconfig.app.json"
      }
    },
    "maas-server": {
      "type": "application",
      "root": "apps/maas-server",
      "entryFile": "main",
      "sourceRoot": "apps/maas-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/maas-server/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json",
        "assets": ["EmailTemplate/**/*"]
      }
    }
  },
  "monorepo": true,
  "root": "apps/maas-server"
}